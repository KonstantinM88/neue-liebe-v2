DATABASE_URL=""
NEXT_PUBLIC_SITE_URL="https://www.neueliebe-nebra.de"

ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACE_ID=""

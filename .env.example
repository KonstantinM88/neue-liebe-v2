DATABASE_URL=""
NEXT_PUBLIC_SITE_URL="https://www.neueliebe-nebra.de"

ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Also signs reservation confirmation and cancellation links; use 32+ random characters and keep stable.
ADMIN_SESSION_SECRET=""

GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACE_ID=""
GOOGLE_PLACE_QUERY="Neue Liebe Nebra"

# Reservation notifications via SMTP. Set these in the deployment environment too.
MAIL_PROVIDER="smtp"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
LEAD_NOTIFY_FROM=""
# One or more recipients, separated by commas.
LEAD_NOTIFY_TO=""
# Optional: local URL reachable from your phone on the same network (development only).
RESERVATION_CONFIRM_DEV_URL=""

# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
# Use "local" temporarily, then change to "s3" after configuring a provider.
NEWS_STORAGE_DRIVER="local"
# Leave OBJECT_STORAGE_ENDPOINT empty only for AWS S3.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_PUBLIC_URL=""
OBJECT_STORAGE_FORCE_PATH_STYLE="false"
OBJECT_STORAGE_PREFIX="neue-liebe"

// prisma/schema.prisma
// Neue Liebe – Restaurant Booking System
// Stack: Prisma 7.7.0 · PostgreSQL · Node.js 22

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Occasion {
  DINNER
  BIRTHDAY
  WEDDING
  CORPORATE
  OTHER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

enum NewsLocale {
  DE
  EN
}

model Reservation {
  id             String            @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String
  date           DateTime          @db.Date
  time           String            // "19:00"
  guests         Int
  occasion       Occasion          @default(DINNER)
  specialRequest String?           @db.Text
  status         ReservationStatus @default(PENDING)
  lang           String            @default("de")  // "de" | "en"
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([date])
  @@index([email])
  @@index([status])
  @@map("reservations")
}

model NewsPost {
  id               String            @id @default(cuid())
  slug             String            @unique
  author           String            @default("Neue Liebe")
  publishedAt      DateTime
  draft            Boolean           @default(true)
  coverImage       String
  coverImageMobile String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  translations     NewsTranslation[]

  @@index([publishedAt])
  @@index([draft, publishedAt])
  @@map("news_posts")
}

model NewsTranslation {
  id             String     @id @default(cuid())
  postId         String
  locale         NewsLocale
  title          String
  excerpt        String     @db.Text
  body           String     @db.Text
  seoTitle       String
  seoDescription String     @db.Text
  keywords       String[]
  keyFacts       String[]
  category       String
  coverAlt       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  post           NewsPost   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([locale])
  @@map("news_translations")
}

// prisma/schema.prisma
// Neue Liebe – Restaurant Booking System
// Stack: Prisma 6.19.2 · PostgreSQL · Node.js 22

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Occasion {
  DINNER
  BIRTHDAY
  WEDDING
  CORPORATE
  OTHER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id             String            @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String
  date           DateTime          @db.Date
  time           String            // "19:00"
  guests         Int
  occasion       Occasion          @default(DINNER)
  specialRequest String?           @db.Text
  status         ReservationStatus @default(PENDING)
  lang           String            @default("de")  // "de" | "en"
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([date])
  @@index([email])
  @@index([status])
  @@map("reservations")
}
